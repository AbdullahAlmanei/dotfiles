* {
active-background: #987E72;
active-foreground: #F0EEE7;
normal-background: #211F1C;
normal-foreground: #F0EEE7;
urgent-background: #AAAB95;
urgent-foreground: #F0EEE7;

alternate-active-background: #AA958C;
alternate-active-foreground: #F0EEE7;
alternate-normal-background: #211F1C;
alternate-normal-foreground: #F0EEE7;
alternate-urgent-background: #211F1C;
alternate-urgent-foreground: #F0EEE7;

selected-active-background: #987E72;
selected-active-foreground: #F0EEE7;
selected-normal-background: #E2DED4;
selected-normal-foreground: #F0EEE7;
selected-urgent-background: #AAAB95;
selected-urgent-foreground: #F0EEE7;

background-color: #211F1C;
background: rgba(0,0,0,0.7);
